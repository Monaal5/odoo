# StockSense IMS — Environment Configuration
# Copy this file to .env and fill in your values

# Application
PROJECT_NAME=StockSense IMS API
DEBUG=True

# JWT
SECRET_KEY=change-me-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocksense
DB_USER=postgres
DB_PASSWORD=postgres
