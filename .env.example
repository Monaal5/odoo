# Application Configuration
PROJECT_NAME="Odoo Hackathon Boilerplate API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Security
SECRET_KEY="super-secret-odoo-hackathon-key-change-in-production"

# Database Configuration
# Default SQLite (zero setup): sqlite:///./hackathon.db
# PostgreSQL Example: postgresql://user:password@localhost:5432/odoo_hackathon_db
DATABASE_URL="sqlite:///./hackathon.db"

# Odoo ERP XML-RPC Connection
ODOO_URL="http://localhost:8069"
ODOO_DB="odoo_db"
ODOO_USER="admin"
ODOO_PASSWORD="admin"
